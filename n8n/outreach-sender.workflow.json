{
  "name": "PitchPilot - Daily Sender",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "triggerAtHour": 9 }] }
      },
      "id": "trg-schedule",
      "name": "Every day 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SHEET_ID",
          "mode": "id"
        },
        "sheetName": { "__rl": true, "value": "Leads", "mode": "name" },
        "options": {}
      },
      "id": "sheets-read",
      "name": "Get all leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [440, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Fold all the row items into ONE item shaped { rows: [...] }\nreturn [{ json: { rows: $input.all().map(i => i.json) } }];"
      },
      "id": "code-bundle",
      "name": "Bundle rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://REPLACE-WITH-YOUR-RENDER-URL.onrender.com/api/plan-today",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "REPLACE_WITH_YOUR_API_KEY" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"rows\": $json.rows, \"limit\": 30 } }}",
        "options": { "timeout": 60000 }
      },
      "id": "http-plan",
      "name": "Plan today (backend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300]
    },
    {
      "parameters": { "fieldToSplitOut": "emails", "options": {} },
      "id": "split-emails",
      "name": "One item per email",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1100, 300]
    },
    {
      "parameters": { "batchSize": 1, "options": {} },
      "id": "loop-batches",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "id": "gmail-send",
      "name": "Send Email (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1560, 200],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SHEET_ID",
          "mode": "id"
        },
        "sheetName": { "__rl": true, "value": "Leads", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["email"],
          "value": {
            "email": "={{ $('Loop Over Items').item.json.to }}",
            "status": "={{ $('Loop Over Items').item.json.update.status }}",
            "sequenceStep": "={{ $('Loop Over Items').item.json.update.sequenceStep }}",
            "nextTouchAt": "={{ $('Loop Over Items').item.json.update.nextTouchAt }}",
            "threadId": "={{ $json.threadId }}",
            "sentAt": "={{ $('Loop Over Items').item.json.update.sentAt }}"
          }
        },
        "options": {}
      },
      "id": "sheets-update",
      "name": "Write status back",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1780, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": { "amount": 45, "unit": "seconds" },
      "id": "wait-node",
      "name": "Wait 45s (human pace)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2000, 200]
    },
    {
      "parameters": {},
      "id": "noop-done",
      "name": "All sent for today",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1560, 420]
    }
  ],
  "connections": {
    "Every day 9am": {
      "main": [[{ "node": "Get all leads", "type": "main", "index": 0 }]]
    },
    "Get all leads": {
      "main": [[{ "node": "Bundle rows", "type": "main", "index": 0 }]]
    },
    "Bundle rows": {
      "main": [[{ "node": "Plan today (backend)", "type": "main", "index": 0 }]]
    },
    "Plan today (backend)": {
      "main": [[{ "node": "One item per email", "type": "main", "index": 0 }]]
    },
    "One item per email": {
      "main": [[{ "node": "Loop Over Items", "type": "main", "index": 0 }]]
    },
    "Loop Over Items": {
      "main": [
        [{ "node": "All sent for today", "type": "main", "index": 0 }],
        [{ "node": "Send Email (Gmail)", "type": "main", "index": 0 }]
      ]
    },
    "Send Email (Gmail)": {
      "main": [[{ "node": "Write status back", "type": "main", "index": 0 }]]
    },
    "Write status back": {
      "main": [
        [{ "node": "Wait 45s (human pace)", "type": "main", "index": 0 }]
      ]
    },
    "Wait 45s (human pace)": {
      "main": [[{ "node": "Loop Over Items", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
