# Copy to ".env" for LOCAL runs:  cp .env.example .env  &&  npm start
# On Render you set these in the dashboard (Environment tab), NOT in a file.

# Local port. On Render, LEAVE THIS UNSET - Render provides PORT automatically.
PORT=3000

# Shared secret. n8n must send it as the "x-api-key" header on every call.
# Use a long random string. Generate one:  node -e "console.log(crypto.randomUUID())"
API_KEY=change-this-to-a-long-random-string

# Max emails per day (first-touches + follow-ups combined).
DAILY_CAP=30
